{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yahwan-shop.github.io/ai-accounting-copilot/rules/rule_schema.json",
  "title": "Company Rule COA",
  "type": "object",
  "required": ["company", "chart_of_accounts", "journal_entry_rules"],
  "additionalProperties": true,
  "properties": {
    "company": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "short_name": { "type": "string" },
        "tax_id": { "type": "string" },
        "business_type": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "chart_of_accounts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "name", "type"],
        "additionalProperties": true,
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": ["asset", "liability", "equity", "revenue", "expense"]
          }
        }
      }
    },
    "journal_entry_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "name",
          "document_types",
          "transaction_type",
          "book_code",
          "entries",
          "validation"
        ],
        "additionalProperties": true,
        "properties": {
          "rule_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "document_types": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "transaction_type": { "type": "string", "minLength": 1 },
          "book_code": { "type": "string", "minLength": 1 },
          "conditions": {
            "type": "object",
            "default": {},
            "additionalProperties": {
              "type": ["string", "number", "integer", "boolean", "null"]
            }
          },
          "entries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["side", "account_code", "amount_field"],
              "additionalProperties": true,
              "properties": {
                "side": { "type": "string", "enum": ["debit", "credit"] },
                "account_code": { "type": "string", "minLength": 1 },
                "account_name": { "type": "string" },
                "amount_field": { "type": "string", "minLength": 1 },
                "description": { "type": "string" },
                "condition": { "type": "string" },
                "is_variable": { "type": "boolean" },
                "alternatives": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["condition", "account_code"],
                    "additionalProperties": true,
                    "properties": {
                      "condition": { "type": "string", "minLength": 1 },
                      "account_code": { "type": "string", "minLength": 1 },
                      "account_name": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "validation": {
            "type": "object",
            "required": ["balance_check"],
            "additionalProperties": true,
            "properties": {
              "balance_check": { "type": "string", "minLength": 1 },
              "formula": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "wht_rates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rate", "description"],
        "additionalProperties": true,
        "properties": {
          "rate": { "type": ["number", "integer"] },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "test_scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scenario_id", "rule_ref", "input", "expected_entries"],
        "additionalProperties": true,
        "properties": {
          "scenario_id": { "type": "string", "minLength": 1 },
          "rule_ref": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "input": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": true
          },
          "expected_entries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["side", "account_code", "amount"],
              "additionalProperties": true,
              "properties": {
                "side": { "type": "string", "enum": ["debit", "credit"] },
                "account_code": { "type": "string", "minLength": 1 },
                "amount": { "type": "number" },
                "note": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
