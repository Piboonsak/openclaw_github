# TASK-1313 SIT click-through credentials — COPY to `.env.sit.local` and fill in.
# `.env.sit.local` is git-ignored (matches `.env.*.local`). NEVER commit real values.
# These are operator-supplied out of band; do not paste them into chat, PRs, or logs.

# Base URL of the SIT review surface
POC_URL=https://sit.yahwan.biz

# nginx Basic-Auth edge credentials (the browser-prompt gate)
SIT_BASIC_USER=
SIT_BASIC_PASS=

# App login credentials (SIT seed admin — the in-app login form)
SIT_APP_USER=
SIT_APP_PASS=
