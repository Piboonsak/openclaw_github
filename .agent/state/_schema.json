{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yahwan-shop.github.io/ai-accounting-copilot/.agent/state/_schema.json",
  "title": "Agent Governance State",
  "description": "Authoritative state for one TASK-<ID>. Single source of truth consumed by gates, hooks, and intake.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "status",
    "risk_tier",
    "model_tier",
    "allowed_scope",
    "forbidden_scope",
    "acceptance_criteria",
    "max_loops",
    "run_count",
    "last_action",
    "escalation_policy",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[A-Z0-9-]+$",
      "description": "Unique task identifier (e.g. TASK-501)."
    },
    "issue_url": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "project_item_id": {
      "type": ["string", "null"],
      "description": "Projects v2 GraphQL node id (PVTI_*) once card is created."
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "IN_PROGRESS",
        "REVIEW_READY",
        "BLOCKED",
        "DONE",
        "VERIFIED"
      ]
    },
    "risk_tier": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "model_tier": {
      "type": "string",
      "enum": [
        "tier-1-opus",
        "tier-2a-copilot",
        "tier-2b-sonnet",
        "tier-3-gemini"
      ]
    },
    "allowed_scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Glob patterns the agent MAY modify."
    },
    "forbidden_scope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Glob patterns the agent MUST NOT modify. Merged with config/model-policy.yaml safety.forbidden_paths."
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "desc"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "desc": { "type": "string", "minLength": 1 },
          "test": { "type": ["string", "null"] }
        }
      }
    },
    "max_loops": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "run_count": {
      "type": "integer",
      "minimum": 0
    },
    "last_action": {
      "type": "string",
      "minLength": 1
    },
    "last_modified_files": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "blocker_reason": {
      "type": ["string", "null"]
    },
    "escalation_policy": {
      "type": "string",
      "enum": ["human", "ai-debate", "stop"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
