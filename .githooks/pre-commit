#!/usr/bin/env sh

echo "Running agent/skill markdown validation..."
npm run --silent validate:agents-skills
STATUS=$?

if [ $STATUS -ne 0 ]; then
  echo ""
  echo "Commit blocked: agent/skill validation failed."
  echo "Fix issues, then re-commit."
  exit $STATUS
fi

echo ""
echo "Running governance Action Lock (min_action_check)..."
PYTHON_BIN="${PYTHON:-python}"
"$PYTHON_BIN" scripts/min_action_check.py
ACTION_STATUS=$?

if [ $ACTION_STATUS -ne 0 ]; then
  echo ""
  echo "Commit blocked: plan-only / state-only commits are not allowed."
  echo "Add code/test/script changes, or set status=BLOCKED with a Blocker section."
  exit $ACTION_STATUS
fi

exit 0

