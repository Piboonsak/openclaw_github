# Environment Variables Example
# Copy this file to .env and update with your actual values.
# This file reflects the variable names read by config/settings.py.

# Application environment
APP_ENV=development
PUBLIC_ENV=development

# Database
DATABASE_URL=postgresql://copilot:dev_password@localhost:5432/ai_accounting_sit
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Paths
RULES_ROOT=./rules
CACHE_ROOT=./src/backend/ml/cache
UPLOAD_ROOT=./src/backend/ml/cache/uploads
EXPORT_ROOT=./src/backend/ml/cache/exports
STORAGE_LOCAL_ROOT=./src/backend/ml/cache/object_store

# Object storage
STORAGE_PROVIDER=minio
STORAGE_DEFAULT_TENANT_ID=default-tenant
STORAGE_PRESIGN_EXPIRE_SECONDS=3600
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=ai-accounting-sit
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_TIMEOUT_SECONDS=5

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=5

# CORS / auth
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OCR / LLM providers
OCR_ENGINE=tesseract
DEFAULT_LOCALE=th_TH
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BWCACC_OPENROUTER_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
STAGE_C_PROVIDER=openrouter
STAGE_C_DEFAULT_MODEL=google/gemini-2.5-flash
STAGE_C_BACKUP_MODELS=openai/gpt-4.1-nano,google/gemini-3.1-flash-lite
STAGE_C_ESCALATION_MODEL=anthropic/claude-sonnet-4
STAGE_C_FREE_MODELS=google/gemini-2.5-flash-lite
STAGE_C_FREE_CONF_THRESHOLD=0.70
STAGE_C_FREE_DAILY_USD_CAP=1.0
STAGE_C_PAID_DAILY_USD_CAP=2.0
STAGE_C_USE_IMAGE_INPUT=true
