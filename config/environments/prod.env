# Production Environment Configuration Placeholder
# Secrets are loaded dynamically via GitHub Actions Secrets injecting into container at boot

STAGE=Prod
DEBUG=false

# Database Configuration (Supplied via AWS RDS Secrets in production)
DATABASE_URL=postgresql://production_user:production_password@prod-rds-postgres.amazonaws.com:5432/ai_accounting_prod

# Production S3 Secure Vault Details
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
STORAGE_BUCKET=ai-accounting-production-vault
# Recommended: load STORAGE_ACCESS_KEY and STORAGE_SECRET_KEY via AWS IAM Role / Secrets

# OCR Service
OCR_SERVICE=textract

# LLM Framework details
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022
MAX_TOKENS_PER_INVOICE=2500

# Security Gate thresholds
CONFIDENCE_THRESHOLD=0.90
ALLOWED_SCOPES=restricted
