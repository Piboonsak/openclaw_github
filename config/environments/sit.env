# SIT Environment Configuration

STAGE=SIT
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_accounting_sit

# Extracted Files and OCR Cache Storage (Mocks or MinIO local)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=ai-accounting-sit
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# OCR Service (AWS Textract for high-precision Thai OCR, or local Tesseract fallback)
OCR_SERVICE=tesseract
TESSERACT_CMD=tesseract

# LLM Framework
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-haiku-20241022
MAX_TOKENS_PER_INVOICE=1500

# Security Gate thresholds
CONFIDENCE_THRESHOLD=0.85
ALLOWED_SCOPES=all
