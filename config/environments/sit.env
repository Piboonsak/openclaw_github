# SIT Environment Configuration
#
# IMPORTANT (2026-07-08 config audit): the live backend imports
# `config.settings` (repo-root config/settings.py). That module is populated
# at container runtime via `docker/.env.sit` through the `env_file:`
# directive in `docker/docker-compose.sit.yml` — NOT this file.
#
# This file is only read by the legacy `src/config/settings.py`
# (re-exported via `src/config/__init__.py`), which nothing under
# `src/backend/**` currently imports. It is kept aligned with
# `config/settings.py` naming below so it stays usable if that legacy path
# is ever revived, but editing this file today has NO effect on real SIT
# runtime behavior.
#
# Authoritative SIT secrets file: docker/.env.sit
# Template for that file:         docker/.env.sit.example

STAGE=SIT
DEBUG=true
APP_ENV=sit
PUBLIC_ENV=sit

# Database
DATABASE_URL=postgresql://ledgerflow:CHANGE_ME@localhost:5432/ledgerflow_sit
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Object storage (MinIO) — extracted files & OCR source cache
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=ledgerflow-sit-docs
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_TIMEOUT_SECONDS=5
STORAGE_LOCAL_ROOT=./src/backend/ml/cache/object_store
STORAGE_DEFAULT_TENANT_ID=default-tenant
STORAGE_PRESIGN_EXPIRE_SECONDS=3600

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=5

# CORS / JWT auth
CORS_ORIGINS=https://sit.yahwan.biz
JWT_SECRET_KEY=CHANGE_ME_USE_openssl_rand_-hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OCR
OCR_ENGINE=tesseract
DEFAULT_LOCALE=th_TH

# LLM / Stage C cascade (OpenRouter-based extraction)
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
OPENAI_API_KEY=
BWCACC_OPENROUTER_API_KEY=
OPENROUTER_API_KEY=CHANGE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
STAGE_C_PROVIDER=openrouter
STAGE_C_DEFAULT_MODEL=google/gemini-2.5-flash
STAGE_C_BACKUP_MODELS=openai/gpt-4.1-nano,google/gemini-3.1-flash-lite
STAGE_C_ESCALATION_MODEL=anthropic/claude-sonnet-4
STAGE_C_FREE_MODELS=google/gemini-2.5-flash-lite
STAGE_C_FREE_CONF_THRESHOLD=0.70
STAGE_C_FREE_DAILY_USD_CAP=1.0
STAGE_C_PAID_DAILY_USD_CAP=2.0
STAGE_C_USE_IMAGE_INPUT=true

# -- Legacy fields (only used by src/config/settings.py, if ever revived) --
MAX_TOKENS_PER_INVOICE=1500
CONFIDENCE_THRESHOLD=0.85
ALLOWED_SCOPES=all
TESSERACT_CMD=tesseract
