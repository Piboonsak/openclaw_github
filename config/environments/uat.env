# UAT Environment Configuration

STAGE=UAT
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_accounting_uat

# Storage configuration (Separate mock / development bucket)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=ai-accounting-uat
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# OCR Setup
OCR_SERVICE=textract
# AWS Textract settings load from ECS/Fargate IAM Role profile

# LLM Framework
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-haiku-20241022
MAX_TOKENS_PER_INVOICE=1500

# Security Gate thresholds
CONFIDENCE_THRESHOLD=0.85
ALLOWED_SCOPES=all
