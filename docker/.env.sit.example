# LedgerFlow SIT environment — ai-accounting-copilot
# Copy to docker/.env.sit and fill in real values.
# NEVER commit docker/.env.sit.

# -- Application -------------------------------------------------
APP_ENV=sit
SECRET_KEY=CHANGE_ME_USE_openssl_rand_-hex_32
ALLOWED_HOSTS=sit.yahwan.biz
CORS_ORIGINS=https://sit.yahwan.biz

# -- Database (PostgreSQL 16) -----------------------------------
POSTGRES_USER=ledgerflow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ledgerflow_sit
DATABASE_URL=postgresql://ledgerflow:CHANGE_ME@postgres:5432/ledgerflow_sit
DB_POOL_SIZE=10
DB_POOL_OVERFLOW=20

# -- Redis 7 -----------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# -- MinIO (S3-compatible storage) ------------------------------
MINIO_ROOT_USER=ledgerflow
MINIO_ROOT_PASSWORD=CHANGE_ME_minimum_16_chars
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=ledgerflow-sit-docs
MINIO_SECURE=false
MINIO_ACCESS_KEY=ledgerflow
MINIO_SECRET_KEY=CHANGE_ME_minimum_16_chars
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://minio:9000
STORAGE_BUCKET=ledgerflow-sit-docs
STORAGE_ACCESS_KEY=ledgerflow
STORAGE_SECRET_KEY=CHANGE_ME_minimum_16_chars

# -- OCR -----------------------------------------------------------
OCR_ENGINE=tesseract
# W5 OCR hotfix: hard-cap one tesseract invocation to avoid long CPU pinning.
OCR_TESSERACT_TIMEOUT_SECONDS=45
DEFAULT_LOCALE=th_TH

# -- LLM / AI / Stage C cascade (config/settings.py names) --------
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
OPENAI_API_KEY=
BWCACC_OPENROUTER_API_KEY=
OPENROUTER_API_KEY=CHANGE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
STAGE_C_PROVIDER=openrouter
STAGE_C_DEFAULT_MODEL=google/gemini-2.5-flash
STAGE_C_BACKUP_MODELS=openai/gpt-4.1-nano,google/gemini-3.1-flash-lite
STAGE_C_ESCALATION_MODEL=anthropic/claude-sonnet-4
STAGE_C_FREE_MODELS=google/gemini-2.5-flash-lite
STAGE_C_FREE_CONF_THRESHOLD=0.70
STAGE_C_FREE_DAILY_USD_CAP=1.0
STAGE_C_PAID_DAILY_USD_CAP=2.0
# W5-COPILOT-PROCESSING-SLOWDOWN-INVESTIGATION-04: set false on SIT to prevent
# image upload hangs from VPS to OpenRouter (540s SoftTimeLimitExceeded).
# The OpenRouterProvider has no HTTP timeout; large base64 PNG uploads from a
# Hostinger VPS exhaust the 540s Celery soft limit before the call returns.
# Re-enable only after app-code adds explicit timeout= to OpenRouterProvider.
STAGE_C_USE_IMAGE_INPUT=false

# -- JWT Authentication ------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_USE_openssl_rand_-hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -- SIT Seeding (required by deploy-sit.sh) --------------------
# W4 review default: admin/admin on first login, then change password immediately after access is confirmed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@ledgerflow.local
COMPANIES_STORE=samples/sit/companies.anonymized.json
