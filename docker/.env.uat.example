# UAT Environment Variables — uat.bwcacc.biz
# Copy to .env.uat and fill in real values. NEVER commit .env.uat to git.
#
# Usage: docker compose -f docker/docker-compose.uat.yml --env-file docker/.env.uat up -d

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=ledgerflow
POSTGRES_PASSWORD=CHANGE_ME_uat_db_password
POSTGRES_DB=ledgerflow_uat

# ── Backend (FastAPI) ─────────────────────────────────────────
DATABASE_URL=postgresql://ledgerflow:CHANGE_ME_uat_db_password@postgres:5432/ledgerflow_uat
APP_ENV=uat
STAGE=UAT

# ── MinIO (S3-compatible storage) ─────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_uat_minio_password
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=ledgerflow-uat
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_uat_minio_password

# ── Redis (Celery broker) ────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── OCR ───────────────────────────────────────────────────────
OCR_ENGINE=tesseract
DEFAULT_LOCALE=th_TH

# ── LLM API Keys (fill with real keys) ───────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Stage C (LLM extraction cascade) ─────────────────────────
STAGE_C_PROVIDER=openrouter
STAGE_C_DEFAULT_MODEL=google/gemini-2.5-flash
STAGE_C_ESCALATION_MODEL=anthropic/claude-sonnet-4
STAGE_C_FREE_MODELS=google/gemini-2.5-flash-lite
STAGE_C_FREE_CONF_THRESHOLD=0.70
STAGE_C_FREE_DAILY_USD_CAP=1.0
STAGE_C_PAID_DAILY_USD_CAP=2.0
