# LedgerFlow UAT environment — ai-accounting-copilot
# Copy to docker/.env.uat and fill in real values
# NEVER commit the filled .env.uat file (it is in .gitignore)
# Generate secrets: openssl rand -hex 32

# -- Application -------------------------------------------------
APP_ENV=uat
SECRET_KEY=CHANGE_ME_USE_openssl_rand_-hex_32
ALLOWED_HOSTS=uat.bwcacc.biz
CORS_ORIGINS=https://uat.bwcacc.biz

# -- Database (PostgreSQL 16) -----------------------------------
POSTGRES_USER=ledgerflow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ledgerflow_uat
DATABASE_URL=postgresql://ledgerflow:CHANGE_ME@postgres:5432/ledgerflow_uat
DB_POOL_SIZE=10
DB_POOL_OVERFLOW=20

# -- Redis 7 -----------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# -- MinIO (S3-compatible storage) ------------------------------
MINIO_ROOT_USER=ledgerflow
MINIO_ROOT_PASSWORD=CHANGE_ME_minimum_16_chars
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=ledgerflow-docs
MINIO_SECURE=false

# -- LLM / AI ----------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# -- JWT Authentication ------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_USE_openssl_rand_-hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -- LINE Notifications ------------------------------------------
LINE_CHANNEL_ACCESS_TOKEN=CHANGE_ME
LINE_USER_ID=CHANGE_ME
