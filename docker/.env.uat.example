# LedgerFlow UAT environment — ai-accounting-copilot
# Copy to docker/.env.uat and fill in real values
# NEVER commit the filled .env.uat file (it is in .gitignore)
# Generate secrets: openssl rand -hex 32

# -- Application -------------------------------------------------
APP_ENV=uat
SECRET_KEY=CHANGE_ME_USE_openssl_rand_-hex_32
ALLOWED_HOSTS=uat.bwcacc.biz
CORS_ORIGINS=https://uat.bwcacc.biz

# -- Database (PostgreSQL 16) -----------------------------------
POSTGRES_USER=ledgerflow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ledgerflow_uat
DATABASE_URL=postgresql://ledgerflow:CHANGE_ME@postgres:5432/ledgerflow_uat
DB_POOL_SIZE=10
DB_POOL_OVERFLOW=20

# -- Redis 7 -----------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# -- MinIO (S3-compatible storage) ------------------------------
# NOTE: MINIO_ROOT_USER/PASSWORD bootstrap the MinIO server itself.
# config/settings.py (the module the live backend reads) needs the app-client
# credentials below (STORAGE_PROVIDER/MINIO_ACCESS_KEY/MINIO_SECRET_KEY) to
# actually match what the server was bootstrapped with, otherwise storage
# writes will fail auth. Keep MINIO_ACCESS_KEY/SECRET_KEY equal to
# MINIO_ROOT_USER/PASSWORD above unless a separate app-only credential has
# been provisioned in MinIO.
MINIO_ROOT_USER=ledgerflow
MINIO_ROOT_PASSWORD=CHANGE_ME_minimum_16_chars
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=ledgerflow-docs
MINIO_SECURE=false
MINIO_ACCESS_KEY=ledgerflow
MINIO_SECRET_KEY=CHANGE_ME_minimum_16_chars
STORAGE_PROVIDER=minio

# -- OCR -----------------------------------------------------------
OCR_ENGINE=tesseract
DEFAULT_LOCALE=th_TH

# -- LLM / AI / Stage C cascade (config/settings.py names) --------
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
OPENAI_API_KEY=
BWCACC_OPENROUTER_API_KEY=
OPENROUTER_API_KEY=CHANGE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
STAGE_C_PROVIDER=openrouter
STAGE_C_DEFAULT_MODEL=google/gemini-2.5-flash
STAGE_C_BACKUP_MODELS=openai/gpt-4.1-nano,google/gemini-3.1-flash-lite
STAGE_C_ESCALATION_MODEL=anthropic/claude-sonnet-4
STAGE_C_FREE_MODELS=google/gemini-2.5-flash-lite
STAGE_C_FREE_CONF_THRESHOLD=0.70
STAGE_C_FREE_DAILY_USD_CAP=1.0
STAGE_C_PAID_DAILY_USD_CAP=2.0
STAGE_C_USE_IMAGE_INPUT=true

# -- JWT Authentication ------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_USE_openssl_rand_-hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -- LINE Notifications ------------------------------------------
LINE_CHANNEL_ACCESS_TOKEN=CHANGE_ME
LINE_USER_ID=CHANGE_ME
