# PROD Environment Variables — app.bwcacc.biz
# Copy to .env.prod and fill in real values. NEVER commit .env.prod to git.
#
# Usage: docker compose -f docker/docker-compose.prod.yml --env-file docker/.env.prod up -d

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=ledgerflow
POSTGRES_PASSWORD=CHANGE_ME_prod_strong_password
POSTGRES_DB=ledgerflow_prod

# ── Backend (FastAPI) ─────────────────────────────────────────
DATABASE_URL=postgresql://ledgerflow:CHANGE_ME_prod_strong_password@postgres:5432/ledgerflow_prod
APP_ENV=production
STAGE=Prod

# ── MinIO (S3-compatible storage) ─────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_prod_minio_strong_password
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=ledgerflow-prod
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_prod_minio_strong_password

# ── Redis (Celery broker) ────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── OCR ───────────────────────────────────────────────────────
OCR_ENGINE=tesseract
DEFAULT_LOCALE=th_TH

# ── LLM API Keys (fill with real keys) ───────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Stage C (LLM extraction cascade) ─────────────────────────
STAGE_C_PROVIDER=openrouter
STAGE_C_DEFAULT_MODEL=google/gemini-2.5-flash
STAGE_C_ESCALATION_MODEL=anthropic/claude-sonnet-4
STAGE_C_FREE_MODELS=google/gemini-2.5-flash-lite
STAGE_C_FREE_CONF_THRESHOLD=0.70
STAGE_C_FREE_DAILY_USD_CAP=1.0
STAGE_C_PAID_DAILY_USD_CAP=2.0
