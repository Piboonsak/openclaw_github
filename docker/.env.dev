# LedgerFlow local development defaults - safe to commit, no real secrets
APP_ENV=development
SECRET_KEY=dev-secret-key-not-for-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

POSTGRES_USER=ledgerflow
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=ledgerflow_dev
DATABASE_URL=postgresql://ledgerflow:devpassword@localhost:5432/ledgerflow_dev
DB_POOL_SIZE=5
DB_POOL_OVERFLOW=10

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=ledgerflow-docs
MINIO_SECURE=false

ANTHROPIC_API_KEY=sk-ant-CHANGE_ME_even_for_dev
JWT_SECRET_KEY=dev-jwt-secret-not-for-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

LINE_CHANNEL_ACCESS_TOKEN=CHANGE_ME
LINE_USER_ID=CHANGE_ME
