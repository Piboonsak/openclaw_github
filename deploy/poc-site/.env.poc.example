APP_ENV=poc-user-trial
PUBLIC_ENV=PoC User Trial
RULES_ROOT=/opt/aiacc-poc/data/rules
CACHE_ROOT=/opt/aiacc-poc/data/cache
UPLOAD_ROOT=/opt/aiacc-poc/data/uploads
EXPORT_ROOT=/opt/aiacc-poc/data/exports
STAGE_C_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
STAGE_C_DEFAULT_MODEL=google/gemini-2.5-flash
STAGE_C_ESCALATION_MODEL=anthropic/claude-sonnet-4
STAGE_C_FREE_MODELS=google/gemini-2.5-flash-lite
STAGE_C_FREE_CONF_THRESHOLD=0.70
STAGE_C_FREE_DAILY_USD_CAP=1.0
STAGE_C_PAID_DAILY_USD_CAP=2.0
OCR_ENGINE=tesseract
DEFAULT_LOCALE=th_TH

# Secrets must be injected by the Openclaw Control Plane workflow.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=